{
  "name": "linkedin-jobs-scraper",
  "version": "18.0.1",
  "description": "Scrape public available jobs on Linkedin using headless browser",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "rm -fr build",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "test-authenticated": "DEBUG=scraper:info jest authenticated.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinlud/linkedin-jobs-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/spinlud/linkedin-jobs-scraper.git/issues"
  },
  "homepage": "https://github.com/spinlud/linkedin-jobs-scraper.git#readme",
  "author": "Ludovico Fabbri",
  "license": "MIT",
  "dependencies": {
    "debug": "^4.4.3",
    "deepmerge": "^4.3.1",
    "puppeteer": "^25.8.0",
    "typed-emitter": "^2.1.0"
  },
  "keywords": [
    "scraper",
    "crawler",
    "Linkedin",
    "jobs",
    "puppeteer",
    "headless",
    "chrome",
    "chromium",
    "text",
    "text-mining",
    "data-mining",
    "machine-learning",
    "selenium"
  ],
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
